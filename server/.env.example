# Hugging Face token for pyannote speaker diarization (required for speaker labels)
HF_TOKEN=hf_your_token_here

# Alternative Hugging Face token env name (also accepted)
# HUGGING_FACE_HUB_TOKEN=hf_your_token_here

# Whisper model size: tiny | base | small | medium | large | large-v3
# Default for /transcribe whisper-local is "base"; LM Studio path may use large-v3
WHISPER_MODEL=base

# Flask bind address (keep 127.0.0.1 for local-only use)
HOST=127.0.0.1

# Flask port (5055 avoids Windows reserving/blocking port 5000)
PORT=5055

# Optional absolute path to ffmpeg if not on PATH
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFMPEG_BIN=/usr/local/bin/ffmpeg

# Optional LM Studio chat completions endpoint (for provider=lmstudio)
# LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
